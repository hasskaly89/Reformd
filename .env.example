# Public site URL (canonical, sitemap, OG)
NEXT_PUBLIC_SITE_URL=https://www.reformdpilates.com.au
# Adobe Fonts web-project kit id (fonts.adobe.com > Web Projects). Defaults to kkx7tho ("Reformd Pilates").
NEXT_PUBLIC_TYPEKIT_ID=kkx7tho
# Live Instagram posts per studio (server-only). A Behold JSON feed URL (https://feeds.behold.so/<id>)
# or an Instagram API media URL with a long-lived token. Same URL for both = one shared grid.
INSTAGRAM_FEED_CECIL_HILLS=
INSTAGRAM_FEED_KINGS_PARK=
# Intro-offer pop-up -> PD Wise (server-only, set in Vercel, never commit values).
# Preferred: PD Wise API. Creates the contact + an opportunity in the "No Purchase" stage.
# Per studio (_CECIL_HILLS / _KINGS_PARK), or un-suffixed if both studios share one sub-account.
PDWISE_TOKEN_CECIL_HILLS=
PDWISE_LOCATION_ID_CECIL_HILLS=
PDWISE_TOKEN_KINGS_PARK=
PDWISE_LOCATION_ID_KINGS_PARK=
# Optional: pipeline name (default: first pipeline with the stage) and stage name (default "No Purchase")
# PDWISE_PIPELINE=
# PDWISE_STAGE=No Purchase
# Fallback: PD Wise inbound webhook (workflow trigger).
CRM_WEBHOOK_URL=
# Optional: link texted to leads per studio (e.g. PD's tracked trigger link). Defaults to the Mindbody intro offer.
INTRO_OFFER_SMS_URL_CECIL_HILLS=
INTRO_OFFER_SMS_URL_KINGS_PARK=
# Preview review tools: email address that "Feedback" emails go to (preview deployments only).
NEXT_PUBLIC_FEEDBACK_EMAIL=
# Meta Pixel (same as the live site and intro landing pages). Set in Production only.
NEXT_PUBLIC_META_PIXEL_ID=
# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Set in Production only, so previews never pollute the data.
NEXT_PUBLIC_GA4_ID=
# Launch day only: let search engines index the site. Leave unset until the domain points at this build.
ALLOW_INDEXING=
