# Public site URL (canonical, sitemap, OG)
NEXT_PUBLIC_SITE_URL=https://www.reformdpilates.com.au
# Adobe Fonts web-project kit id (fonts.adobe.com > Web Projects). Defaults to kkx7tho ("Reformd Pilates").
NEXT_PUBLIC_TYPEKIT_ID=kkx7tho
# Live Instagram posts per studio (server-only). A Behold JSON feed URL (https://feeds.behold.so/<id>)
# or an Instagram API media URL with a long-lived token. Same URL for both = one shared grid.
INSTAGRAM_FEED_CECIL_HILLS=
INSTAGRAM_FEED_KINGS_PARK=
# Intro-offer pop-up: CRM inbound webhook (PD Wise / GoHighLevel workflow trigger). Server-only.
CRM_WEBHOOK_URL=
# Optional: link texted to leads per studio (e.g. PD's tracked trigger link). Defaults to the Mindbody intro offer.
INTRO_OFFER_SMS_URL_CECIL_HILLS=
INTRO_OFFER_SMS_URL_KINGS_PARK=
